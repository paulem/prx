{
  "name": "prx",
  "version": "0.1.0",
  "private": true,
  "description": "macOS command-line launcher that starts one app at a time through a configured proxy",
  "license": "MIT",
  "bin": {
    "prx": "dist/prx.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "1.8.0",
    "commander": "15.0.0",
    "undici": "8.10.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "tsup": "8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.11.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

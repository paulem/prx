{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "import", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "no-await-in-loop": "off"
  },
  "env": {
    "node": true
  },
  "ignorePatterns": ["dist/**"]
}
